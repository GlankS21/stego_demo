# Ứng dụng KHÔNG cần biến môi trường hay khoá bí mật nào để chạy.
# File này chỉ là mẫu tuỳ chọn: copy thành .env (đã bị .gitignore loại trừ) nếu muốn đổi cổng Streamlit.
# Streamlit tự đọc các biến STREAMLIT_* khi chạy `streamlit run app.py`.
STREAMLIT_SERVER_PORT=8501
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
